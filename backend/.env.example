# Copy to .env (never commit it). Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
PORT=3000
# Use 0.0.0.0 to reach the API from a phone on the same Wi-Fi (Expo Go).
HOST=127.0.0.1
DATABASE_PATH=./data/fitsphere.db
CORS_ORIGINS=http://localhost:8081,http://localhost:8090
# AI coach (Gemini). Optional: without a key the coach uses built-in rule-based answers.
# Get a key at https://aistudio.google.com/apikey. Server-side only; never put it in the app's .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=20000
AI_CHAT_PER_HOUR=20
