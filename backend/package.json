{
  "name": "fitsphere-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "start:prod": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "seed:dev": "tsx --tsconfig ../tsconfig.json --env-file=.env scripts/seed-dev.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@fastify/cors": "^11.3.1",
    "@google/genai": "^2.32.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.17",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
