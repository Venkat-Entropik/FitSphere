# Copy to .env and adjust. Only EXPO_PUBLIC_* variables are bundled into the app,
# so NEVER put secrets (Gemini keys etc.) here — AI calls go through the backend.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Sign-in/sign-up always talk to the backend (backend/). This flag only controls whether the
# *rest* of the app's data (workouts, nutrition, …) still comes from the on-device sample backend.
EXPO_PUBLIC_USE_MOCKS=true
# On a physical phone, localhost is the phone itself: use your computer's LAN IP, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000 (and run the backend with HOST=0.0.0.0).
